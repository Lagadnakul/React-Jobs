{
    "version": 2,
    "builds": [
      {
        "src": "src/jobs.json",
        "use": "@vercel/static"
      },
      {
        "src": "package.json",
        "use": "@vercel/static-build",
        "config": {
          "distDir": "dist"
        }
      }
    ],
    "routes": [
      {
        "src": "/api/jobs/(.*)",
        "dest": "src/jobs.json"
      },
      {
        "src": "/(.*)",
        "dest": "/index.html"
      }
    ]
}